<?xml version="1.0" encoding="UTF-8"?>

<!-- settings.xml usado SOLO por CI (.github/workflows/deploy.yml).
     Las credenciales llegan como variables de entorno desde los GitHub Secrets;
     nunca se escriben en el repo. Para desarrollo local se sigue usando ~/.m2/settings.xml. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="
              http://maven.apache.org/SETTINGS/1.0.0
              https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <servers>

        <server>
            <id>nexus-snapshots</id>
            <username>${env.NEXUS_USERNAME}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>

        <server>
            <id>nexus-releases</id>
            <username>${env.NEXUS_USERNAME}</username>
            <password>${env.NEXUS_PASSWORD}</password>
        </server>

    </servers>

</settings>
